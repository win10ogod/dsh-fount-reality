{
  "name": "dsh-fount-reality",
  "version": "0.1.2",
  "description": "Fount-inspired autonomous screen observer for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/win10ogod/dsh-fount-reality.git"
  },
  "homepage": "https://github.com/win10ogod/dsh-fount-reality#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screen-capture",
    "autonomous-agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2 || 0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4 || 3.18.5-alpha.1",
    "@screen-capture/node": "1.1.0",
    "node-notifier": "10.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/sensor.js && node --check lib/attention.js && node --test",
    "smoke:capture": "node scripts/native-smoke.mjs"
  }
}
